# 서버 설정
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string

# IP 화이트리스트 (콤마로 구분, 비워두면 비활성화)
IP_WHITELIST=

# 관리자 대시보드 로그인 계정
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ringtalk

# 알림톡/문자 발송 (BizPPurio)
BIZPPURIO_BASE_URL=https://api.bizppurio.com
BIZPPURIO_ACCOUNT=
BIZPPURIO_AUTH_TOKEN=
BIZPPURIO_SENDER_KEY=
BIZPPURIO_TEMPLATE_CODE=

# 창고/발주 연동 API (Warehouse)
WAREHOUSE_BASE_URL=
WAREHOUSE_CUSTOMER_CODE=
WAREHOUSE_CUSTOMER_AUTH=

# eSIM 원격 발급(RSP+) API - axios 클라이언트용
RSP_BASE_URL=
RSP_APP_ID=
RSP_APP_SECRET=
RSP_NOTIFY_BASE_URL=

# eSIM 사용량 조회 / 쿠폰 리딤 Open API
ESIM_OPENAPI_BASE_URL=
ESIM_OPENAPI_APP_ID=
ESIM_OPENAPI_APP_SECRET=

# 네이버 커머스 API (Java 배치 클라이언트와 값 공유)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
